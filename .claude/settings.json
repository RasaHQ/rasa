{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.git/)",
      "Read(./.devcontainer)",
      "Read(./.venv)",
      "Read(./*venv)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "exec $CLAUDE_PROJECT_DIR/.claude/hooks/pre-gh-pr-create.sh"
          }
        ]
      }
    ]
  }
}
