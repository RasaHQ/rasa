{
  "name": "@rasahq/rasa-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://europe-west3-npm.pkg.dev/rasa-releases/rasa-inspector/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RasaHQ/rasa-private.git"
  },
  "workspaces": [
    "e2e"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "yarn workspace inspector-e2e e2e",
    "test:e2e:watch": "yarn workspace inspector-e2e e2e:watch",
    "test:e2e:debug": "yarn workspace inspector-e2e e2e:debug",
    "test:watch": "vitest watch",
    "report:e2e": "yarn workspace inspector-e2e report",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./src/Inspector.tsx"
    },
    "./types": {
      "import": "./src/types/index.ts"
    }
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/pro-light-svg-icons": "^6.7.2",
    "@fortawesome/pro-regular-svg-icons": "^6.7.2",
    "@fortawesome/pro-solid-svg-icons": "^6.7.2",
    "@fortawesome/pro-thin-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/store": "^0.11.0",
    "elkjs": "^0.11.1",
    "immutable-json-patch": "^6.0.2",
    "lodash": "4.18.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^15.6.6",
    "reactflow": "11.11.4",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "cross-spawn": "7.0.6",
    "dompurify": "3.3.2",
    "braces": "3.0.3",
    "ws": "8.19.0",
    "rollup": "^4.43.0",
    "@adobe/css-tools": "^4.4.4",
    "prismjs": "^1.30.0",
    "minimatch": "^9.0.7",
    "picomatch": "4.0.4",
    "follow-redirects": "1.16.0",
    "vite": "7.3.2",
    "flatted": "3.4.2",
    "brace-expansion": "2.0.3",
    "socket.io-parser": "4.2.6"
  },
  "lint-staged": {
    "*.{json,html,css,yml,js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
